<?xml version="1.0" encoding="UTF-8"?>
<itop_design xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="3.0">

    <classes>

        <!--
            Extends the standard iTop Server class.

            Added attributes:
            - open_incident_count:
              stores the number of currently open incidents linked to the server.

            - last_incident_date:
              stores the date of the most recent open incident linked to the server.

            These values are calculated and updated automatically by the PHP hook logic.
            No iTop core file is modified.
        -->
        <class id="Server" _delta="must_exist">
            <fields>

                <!-- Number of open incidents linked to the server. -->
                <field id="open_incident_count" xsi:type="AttributeInteger" _delta="define">
                    <sql>open_incident_count</sql>
                    <default_value>0</default_value>
                    <is_null_allowed>false</is_null_allowed>
                    <tracking_level>all</tracking_level>
                </field>

                <!-- Date of the latest open incident linked to the server. -->
                <field id="last_incident_date" xsi:type="AttributeDateTime" _delta="define">
                    <sql>last_incident_date</sql>
                    <default_value/>
                    <is_null_allowed>true</is_null_allowed>
                    <tracking_level>all</tracking_level>
                </field>

            </fields>

            <!--
                Displays the new fields in the existing Server detail view.

                The fields are added to the existing "other information" fieldset
                in the second column of the Server presentation.
            -->
            <presentation>
                <details>
                    <items>
                        <item id="col:col2" _delta="must_exist">
                            <items>
                                <item id="fieldset:Server:otherinfo" _delta="must_exist">
                                    <items>
                                        <item id="open_incident_count" _delta="define">
                                            <rank>40</rank>
                                        </item>
                                        <item id="last_incident_date" _delta="define">
                                            <rank>50</rank>
                                        </item>
                                    </items>
                                </item>
                            </items>
                        </item>
                    </items>
                </details>
            </presentation>
        </class>


        <!--
            Extends the standard iTop ApplicationSolution class.

            This class was chosen as the second class because an application
            can also be impacted by incidents.

            Adding the same incident summary to ApplicationSolution helps users
            quickly identify applications with active incidents.
        -->
        <class id="ApplicationSolution" _delta="must_exist">
            <fields>

                <!-- Number of open incidents linked to the application solution. -->
                <field id="open_incident_count" xsi:type="AttributeInteger" _delta="define">
                    <sql>open_incident_count</sql>
                    <default_value>0</default_value>
                    <is_null_allowed>false</is_null_allowed>
                    <tracking_level>all</tracking_level>
                </field>

                <!-- Date of the latest open incident linked to the application solution. -->
                <field id="last_incident_date" xsi:type="AttributeDateTime" _delta="define">
                    <sql>last_incident_date</sql>
                    <default_value/>
                    <is_null_allowed>true</is_null_allowed>
                    <tracking_level>all</tracking_level>
                </field>

            </fields>

            <!--
                Displays the new fields in the ApplicationSolution detail view.

                A direct presentation insertion is used here because the
                ApplicationSolution presentation structure is different from Server.
            -->
            <presentation>
                <details>
                    <items>
                        <item id="open_incident_count" _delta="define">
                            <rank>900</rank>
                        </item>

                        <item id="last_incident_date" _delta="define">
                            <rank>910</rank>
                        </item>
                    </items>
                </details>
            </presentation>
        </class>

    </classes>

</itop_design>