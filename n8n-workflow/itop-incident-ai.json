      "id": "67e75ce5-948b-4846-91cd-60640089ca6c",
      "name": "GET Incident iTop",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const objects = $json.objects;\nconst key = Object.keys(objects)[0];\nconst incident = objects[key].fields;\n\nconst prompt = `Tu es un expert ITSM. Analyse cet incident iTop et reponds en francais.\n\nTitre : ${incident.title}\nDescription : ${incident.description || 'Non renseignee'}\nStatut : ${incident.status}\nDate de debut : ${incident.start_date}\n\nReponds avec ce format exact :\nResume : (1 phrase courte)\nCause probable : (1 phrase)\nPriorite suggeree : (Critique / Haute / Moyenne / Basse)\nAction recommandee : (1 phrase)`;\n\nreturn {\n  incident_id: $('Webhook').item.json.body.incident_id,\n  incident_ref: incident.ref || '',\n  incident_title: incident.title || '',\n  incident_status: incident.status || '',\n  prompt: prompt\n};"
      },
      "id": "0cfe2964-9c37-45d4-89b1-082580beb697",
      "name": "Prepare Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const aiResponse =\n  $json.choices?.[0]?.message?.content\n  || 'Analyse non disponible';\n\nconst incidentId = $('Prepare Prompt').first().json.incident_id;\n\nreturn [\n  {\n    json: {\n      incident_id: incidentId,\n      ai_analysis: aiResponse,\n      json_data: JSON.stringify({\n        operation: 'core/update',\n        class: 'Incident',\n        key: incidentId,\n        fields: {\n          ai_analysis: aiResponse\n        },\n        comment: 'Analyse IA générée automatiquement par n8n'\n      })\n    }\n  }\n];"
      },
      "id": "8f7b9297-b385-4c74-ad7f-b6e7bbd0a91c",
      "name": "Prepare Update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
